{
  "buildCommand": "npm install --prefix client && npm run build --prefix client",
  "outputDirectory": "client/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/assets/blobs/:path*", "destination": "/api/index" },
    { "source": "/editor", "destination": "/index.html" },
    { "source": "/library", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "client/public/**"
    }
  }
}
