      "id": "joy",
      "text": "Imagery radiates togetherness, refreshment and joy — never clinical or corporate.",
      "severity": "warn"
    },
    {
      "id": "contrast",
      "text": "Headlines are white on red or black on cream. Never grey.",
      "severity": "error"
    }
