  "rules": [
    {
      "id": "contrast",
      "text": "Headline text must be ink (#00124E) or white with strong contrast; never low-contrast on sky.",
      "severity": "error"
    },
    {
      "id": "logo-once",
      "text": "The xero wordmark appears once, from the asset library, with clear-space at least its cap-height.",
      "severity": "error"
    },
    {
      "id": "palette",
      "text": "Use only brand palette colours. Blue and sky for shapes and blooms; charms are accents only.",
      "severity": "error"
    },
    {
      "id": "ticks",
      "text": "Feature lists use green ticks with short uppercase labels (ACCOUNTING, PAYMENTS, PAYROLL, ANALYTICS).",
      "severity": "warn"
    },
    {
      "id": "safezone",
      "text": "Respect Meta safe zones on social placements; keep the logo and CTA inside the safe area.",
      "severity": "warn"
    },
    {
      "id": "learned-resized-shape",
      "text": "Resize shapes proportionally; never distort or stretch Xero brand shapes.",
      "severity": "warn"
    },
    {
      "id": "learned-moved-shape",
      "text": "Keep brand shapes in their original position; never move or reposition them.",
      "severity": "warn"
    }
  ],
  "voice": "Friendly, plain-spoken and encouraging. Short active sentences that talk to small-business owners like a helpful partner. Confident, never jargon-y. Examples: 'Get a Xero Coach. Get ahead.' / 'Up and running in under 4 hours.' / 'Other software holds you back. Xero holds your hand.'",
