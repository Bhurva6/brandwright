  "rules": [
    {
      "id": "soft",
      "text": "Everything is soft and rounded — generous curves, no sharp corners, no harsh contrast.",
      "severity": "warn"
    },
    {
      "id": "calm",
      "text": "Copy soothes, never pressures. No urgency, no FOMO, no exclamation-mark stacking.",
      "severity": "error"
    },
    {
      "id": "warm",
      "text": "Warm grounds (orange/cream); ink text on light, white text on orange.",
      "severity": "error"
    },
    {
      "id": "learned-edited-design",
      "text": "Use sentence case for design labels; never capitalize \"design.",
      "severity": "warn"
    }
  ],
  "voice": "Warm, gentle, lightly playful. Permission-giving, never preachy: 'Less overthinking. More you.' 'Meditation made simple.' Breathes between words.",
